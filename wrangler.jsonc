{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "texevo-web",
  "account_id": "48dd3aa43c937cea4bbb1840184461cc",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "texevo-web" }],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "b1f0468206c14d659fb4df9142cca7b4" }],
  "vars": {
    "SITE_MODE": "preview",
    "SITE_URL": "https://texevo-web.zaman-ase365.workers.dev",
    "DEPLOY_TARGET": "cloudflare",
    "NEWSLETTER_ENABLED": "false",
    "TRUST_PROXY": "true",
    "S3_ENDPOINT": "https://t3.storage.dev",
    "S3_REGION": "auto",
    "S3_FORCE_PATH_STYLE": "false",
    "S3_BUCKET": "texevo-private-uploads",
  },
  "observability": { "enabled": true },
}
