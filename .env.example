# Preview is deliberately noindex. Never switch to live before check:launch passes.
SITE_MODE=preview
SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://texevo@127.0.0.1:55432/texevo
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
# Protected administration: supply both values even on a staging deployment.
ADMIN_GATE_USER=
ADMIN_GATE_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
CONTACT_EMAIL=
CONTACT_PHONE=
LEGAL_ENTITY=
LEGAL_ADDRESS=
LEGAL_REPRESENTATIVE=
LEGAL_REGISTER=
LEGAL_VAT_ID=
PRIVACY_CONTACT=
LEGAL_REVIEWED=false
CONTENT_APPROVED=false
ADMIN_MFA_CONFIRMED=false
RESTORE_REHEARSED=false
TRUST_PROXY=false
# Transactional/CRM webhooks must honour the documented Idempotency-Key contract.
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
ALERT_WEBHOOK_URL=
# Private S3-compatible bucket, never a public media bucket.
S3_ENDPOINT=
S3_REGION=eu-central-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Scanner contract: POST binary; JSON {"status":"clean"|"infected"}.
SCAN_URL=
SCAN_TOKEN=
# Enable only after sender/processor review and tested confirmation + suppression.
NEWSLETTER_ENABLED=false
NEWSLETTER_WEBHOOK_URL=
NEWSLETTER_WEBHOOK_TOKEN=
